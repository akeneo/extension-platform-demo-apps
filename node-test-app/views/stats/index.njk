{% extends 'base.njk' %}

{% block title %}Stats — Akeneo Marketplace{% endblock %}

{% block body %}
<main class="max-w-7xl mx-auto px-6 py-8">

    <div id="stats-loading" class="flex flex-col items-center justify-center py-32 text-gray-400">
        <div class="w-10 h-10 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin mb-4"></div>
        <p class="text-sm">Loading stats…</p>
    </div>

    <div id="stats-content" class="hidden space-y-8">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Total Products</p>
                <p id="stat-total" class="text-3xl font-bold text-gray-800">—</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Enabled</p>
                <p id="stat-enabled" class="text-3xl font-bold text-green-600">—</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Variants</p>
                <p id="stat-variants" class="text-3xl font-bold text-purple-600">—</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Categories</p>
                <p id="stat-categories" class="text-3xl font-bold text-blue-600">—</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-700 mb-4">Status</h2>
                <div class="flex justify-center"><div class="relative w-52 h-52"><canvas id="chart-status"></canvas></div></div>
                <div id="legend-status" class="flex justify-center gap-6 mt-4 text-sm text-gray-600"></div>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-700 mb-4">Type</h2>
                <div class="flex justify-center"><div class="relative w-52 h-52"><canvas id="chart-type"></canvas></div></div>
                <div id="legend-type" class="flex justify-center gap-6 mt-4 text-sm text-gray-600"></div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-700 mb-4">Products by Category <span class="text-xs font-normal text-gray-400">(top 12)</span></h2>
                <canvas id="chart-categories" class="max-h-80"></canvas>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-700 mb-4">Sync Activity <span class="text-xs font-normal text-gray-400">(last 14 days)</span></h2>
                <canvas id="chart-sync" class="max-h-80"></canvas>
            </div>
        </div>
    </div>

    <div id="stats-error" class="hidden text-center py-20 text-gray-400">
        <div class="text-5xl mb-4">⚠️</div>
        <p class="text-lg font-medium text-gray-600">Failed to load stats</p>
        <p class="text-sm mt-1">Check the console for details.</p>
    </div>

</main>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(async function () {
    const loading = document.getElementById('stats-loading');
    const content = document.getElementById('stats-content');
    const errorEl = document.getElementById('stats-error');
    const purple = ['#7c3aed','#a78bfa'];
    const indigo = ['#4f46e5','#818cf8'];
    const blues  = ['#1d4ed8','#2563eb','#3b82f6','#60a5fa','#93c5fd','#bfdbfe','#dbeafe','#e0e7ff','#c7d2fe','#a5b4fc','#818cf8','#6366f1'];

    function buildLegend(id, labels, colors) {
        document.getElementById(id).innerHTML = labels.map((l, i) =>
            `<span class="flex items-center gap-1.5"><span style="background:${colors[i]}" class="inline-block w-3 h-3 rounded-full"></span>${l}</span>`
        ).join('');
    }
    function doughnut(id, labels, values, colors) {
        new Chart(document.getElementById(id).getContext('2d'), { type: 'doughnut', data: { labels, datasets: [{ data: values, backgroundColor: colors, borderWidth: 2, borderColor: '#fff' }] }, options: { cutout: '68%', plugins: { legend: { display: false } } } });
    }
    function hBar(id, labels, values, color) {
        new Chart(document.getElementById(id).getContext('2d'), { type: 'bar', data: { labels, datasets: [{ data: values, backgroundColor: color, borderRadius: 4, borderSkipped: false }] }, options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f3f4f6' } }, y: { ticks: { font: { size: 12 } }, grid: { display: false } } } } });
    }
    function vBar(id, labels, values, color) {
        new Chart(document.getElementById(id).getContext('2d'), { type: 'bar', data: { labels, datasets: [{ data: values, backgroundColor: color, borderRadius: 4, borderSkipped: false }] }, options: { plugins: { legend: { display: false } }, scales: { x: { ticks: { font: { size: 11 } }, grid: { display: false } }, y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f3f4f6' } } } } });
    }
    function fillDays(data) {
        const map = {};
        data.forEach(d => { map[d.day] = d.count; });
        const result = [];
        for (let i = 13; i >= 0; i--) {
            const d = new Date(); d.setDate(d.getDate() - i);
            const key = d.toISOString().slice(0, 10);
            result.push({ day: key, count: map[key] ?? 0 });
        }
        return result;
    }
    try {
        const res = await fetch('/api/stats');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const s = await res.json();
        document.getElementById('stat-total').textContent      = s.total.toLocaleString();
        document.getElementById('stat-enabled').textContent    = s.enabled.toLocaleString();
        document.getElementById('stat-variants').textContent   = s.variants.toLocaleString();
        document.getElementById('stat-categories').textContent = s.by_category.length.toLocaleString();
        doughnut('chart-status', ['Enabled','Disabled'], [s.enabled, s.disabled], purple);
        buildLegend('legend-status', ['Enabled','Disabled'], purple);
        doughnut('chart-type', ['Variant','Simple'], [s.variants, s.simple], indigo);
        buildLegend('legend-type', ['Variant','Simple'], indigo);
        const catColors = s.by_category.map((_,i) => blues[i % blues.length]);
        if (s.by_category.length > 0) hBar('chart-categories', s.by_category.map(c => c.label), s.by_category.map(c => c.count), catColors);
        const days = fillDays(s.synced_by_day);
        vBar('chart-sync', days.map(d => d.day.slice(5)), days.map(d => d.count), '#6366f1');
        loading.classList.add('hidden');
        content.classList.remove('hidden');
    } catch (err) {
        console.error('Stats error:', err);
        loading.classList.add('hidden');
        errorEl.classList.remove('hidden');
    }
})();
</script>
{% endblock %}
